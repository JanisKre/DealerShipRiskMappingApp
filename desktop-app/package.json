{
  "name": "dealership-risk-desktop",
  "productName": "Dealership Risk Mapping",
  "version": "0.2.1",
  "description": "Desktop app for physical risk assessment of car dealership portfolios",
  "main": "./out/main/index.cjs",
  "author": "Janis Kretschmann",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-rebuild -f --only better-sqlite3,onnxruntime-node,sharp",
    "lint": "eslint --max-warnings 0 --no-warn-ignored src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke-test.mjs",
    "release:metadata": "node scripts/create-release-metadata.mjs",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "benchmark:boundary": "BOUNDARY_BENCHMARK=1 vitest run src/main/services/boundary/boundary-benchmark.run.test.ts",
    "benchmark:boundary:fused": "BOUNDARY_BENCHMARK=1 BOUNDARY_ENGINE=fused vitest run src/main/services/boundary/boundary-benchmark.run.test.ts"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@geoman-io/leaflet-geoman-free": "^2.19.3",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.9",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@tanstack/react-table": "^8.21.3",
    "@turf/area": "^7.3.5",
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@turf/centroid": "^7.3.5",
    "@turf/distance": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "@turf/intersect": "^7.4.0",
    "@turf/union": "^7.4.0",
    "better-sqlite3": "13.0.3",
    "cmdk": "^1.1.1",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "i18next": "25.3.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "0.539.0",
    "onnxruntime-node": "^1.29.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-i18next": "15.6.0",
    "react-leaflet": "5.0.0",
    "react-resizable-panels": "^4.12.4",
    "react-router-dom": "7.18.3",
    "recharts": "^2.15.4",
    "sharp": "^0.35.4",
    "sonner": "^2.0.6",
    "zod": "3.25.76",
    "zustand": "5.0.7"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "1.0.1",
    "@tailwindcss/vite": "4.1.11",
    "@types/better-sqlite3": "7.6.13",
    "@types/leaflet": "1.9.20",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "22.16.5",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "5.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "9.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "3.6.2",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "1.3.6",
    "typescript": "5.8.3",
    "vite": "^7.3.6",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "onnxruntime-node@1.29.0": true,
    "sharp@0.35.4": true,
    "electron@44.3.0": true
  },
  "overrides": {
    "uuid": "11.1.1",
    "js-yaml": "4.3.2"
  }
}
