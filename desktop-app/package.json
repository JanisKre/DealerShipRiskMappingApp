{
  "name": "dealership-risk-desktop",
  "productName": "Dealership Risk Mapping",
  "version": "0.4.0",
  "description": "Desktop app for physical risk assessment of car dealership portfolios",
  "main": "./out/main/index.cjs",
  "author": "Janis Kretschmann",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build && node scripts/generate-third-party-notices.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-rebuild -f --only better-sqlite3,onnxruntime-node,sharp",
    "lint": "eslint --max-warnings 0 --no-warn-ignored src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke-test.mjs",
    "release:metadata": "node scripts/create-release-metadata.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "benchmark:boundary": "BOUNDARY_BENCHMARK=1 vitest run src/main/services/boundary/boundary-benchmark.run.test.ts",
    "benchmark:boundary:replay": "vitest run src/main/services/boundary/boundary-replay.run.test.ts",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@geoman-io/leaflet-geoman-free": "^2.20.6",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-table": "9.3.1",
    "@turf/area": "^7.4.0",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "@turf/helpers": "^7.3.5",
    "@turf/union": "^7.4.0",
    "better-sqlite3": "13.0.3",
    "cmdk": "^1.1.1",
    "drizzle-orm": "0.45.4",
    "electron-updater": "6.8.12",
    "exceljs": "^4.4.0",
    "hyparquet": "1.33.0",
    "hyparquet-compressors": "1.1.3",
    "i18next": "26.7.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "leaflet": "1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "1.71.0",
    "onnxruntime-node": "^1.31.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.13",
    "react-resizable-panels": "^4.21.0",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "4.0.0",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/better-sqlite3": "9.6.0",
    "@types/leaflet": "1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "axe-core": "4.14.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "onnxruntime-node@1.29.0": true,
    "sharp@0.35.4": true,
    "electron@44.3.0": true
  },
  "overrides": {
    "uuid": "11.1.1",
    "js-yaml": "4.3.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.5"
    },
    "app-builder-lib": {
      "minimatch": "11.0.5",
      "glob": {
        "minimatch": "3.1.5"
      }
    },
    "@electron/universal": {
      "minimatch": "11.0.5",
      "dir-compare": {
        "minimatch": "3.1.5"
      }
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.5"
    }
  }
}
