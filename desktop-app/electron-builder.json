{
  "appId": "io.github.janiskre.dealership-risk-mapping",
  "productName": "Dealership Risk Mapping",
  "artifactName": "${name}-${os}-${arch}.${ext}",
  "directories": {
    "output": "release",
    "buildResources": "resources"
  },
  "files": ["out/**/*", "!out/licenses/**", "package.json"],
  "extraResources": [
    { "from": "resources/models", "to": "models" },
    { "from": "out/licenses", "to": "licenses" }
  ],
  "asarUnpack": ["**/*.node"],
  "publish": {
    "provider": "github",
    "owner": "JanisKre",
    "repo": "DealerShipRiskMappingApp"
  },
  "mac": {
    "icon": "resources/icon.icns",
    "target": [{ "target": "dmg", "arch": ["x64", "arm64"] }],
    "category": "public.app-category.business"
  },
  "win": {
    "icon": "resources/icon.ico",
    "target": ["nsis"]
  },
  "linux": {
    "icon": "resources/icon.png",
    "target": ["AppImage"]
  }
}
